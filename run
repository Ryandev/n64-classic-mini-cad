#!/usr/bin/env bash
# Task dispatcher for cad/ -- run `./run` or `./run help` to see targets.
# Every command invokes the cadquery micromamba env defined in ONE place below.
set -euo pipefail

cd "$(dirname "$0")"

PY="$HOME/.local/bin/micromamba run -n cadquery"

target="${1:-help}"
shift || true

case "$target" in
    lint)
        echo "=== ruff check ==="
        $PY ruff check .
        echo "=== ruff format --check ==="
        $PY ruff format --check .
        echo "=== lint_structure.py ==="
        $PY python3 lib/testing/lint_structure.py "$@"
        echo "=== selftest snippets still exist ==="
        $PY python3 lib/gate_selftest.py --check-snippets
        ;;
    format)
        $PY ruff format .
        $PY ruff check --fix .
        ;;
    test)
        # Pass part names to filter, e.g. `./run test lower_tub`
        $PY python3 lib/testing/harness.py "$@"
        ;;
    gate)
        $PY python3 lib/gate.py "$@"
        ;;
    selftest)
        $PY python3 lib/gate_selftest.py "$@"
        ;;
    export)
        $PY python3 lib/testing/export_harness.py "$@"
        ;;
    plate)
        $PY python3 lib/plate.py "$@"
        ;;
    export-validate)
        $PY python3 lib/testing/export_validate.py "$@"
        ;;
    bom)
        $PY python3 lib/bom.py "$@"
        ;;
    fem)
        $PY python3 lib/testing/fem_check.py "$@"
        ;;
    radxa-ref)
        $PY python3 lib/step/build_radxa_x4.py "$@"
        ;;
    coupons)
        $PY python3 lib/coupons.py "$@"
        ;;
    orient)
        $PY python3 lib/orientation_study.py "$@"
        ;;
    all)
        ./run lint
        ./run gate
        ./run export
        ./run export-validate
        ;;
    help|*)
        cat <<'EOF'
usage: ./run <target> [args...]

targets:
  lint             ruff check + ruff format --check + structural lint
  format           ruff check --fix + ruff format
  test [parts...]  geometry test harness (all parts, or only the named ones)
  gate [checks...] subassembly / assembly check rows (PASS/FAIL gate)
  selftest [--only ROW..]  mutation self-test proving gate rows fail on planted defects
  export [--printable-only]  STEP / SVG exports and print plate into export/
                   (--printable-only: printed parts only, no reference models needed)
  plate            orient and pack all 12 FDM parts onto export/plate/print_plate.step
  export-validate  verify exported files exist, match 3D solids, and fit bed
  bom              generate notes/BOM_COMPLETE.md from parametric subassemblies
  fem              Gmsh + CalculiX 3D tetrahedral FEM structural verification
  coupons [NAME..] print-test coupons cut from the real parts into export/coupons/
  orient [PART..]  how each visible part's skin prints (wall/terraced/support...) per orientation
  radxa-ref [ZIP]  rebuild lib/step/radxa_x4.step from Radxa's download (SHA-256 checked)
  all              lint + gate + export + export-validate
EOF
        [[ "$target" == "help" ]]
        ;;
esac
